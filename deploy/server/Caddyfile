# Reference only: provision.sh writes /etc/caddy/Caddyfile. SITE is the domain (Let's Encrypt) or the public IP
# (add `tls internal` inside the block: self-signed, browsers warn, check with curl -k). To move from the IP to a
# public certificate, point the domain's A record at the VM and re-run provision.sh with the domain as its second
# argument (docs/going-public.md, "Steps that need Sam"): it drops `tls internal` and restarts Caddy.
SITE {
	reverse_proxy 127.0.0.1:8000
}
