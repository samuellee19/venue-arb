[Unit]
Description=venue-arb order-book snapshot collector

[Service]
WorkingDirectory=%h/projects/venue-arb
Environment=BWS_PROJECT_ID=42f2b924-cf96-49c8-85a3-b4e4001765b4
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/platform
ExecStart=%h/.local/bin/secrets %h/.local/bin/uv run python -m venue_arb.collect
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
