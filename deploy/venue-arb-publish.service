[Unit]
Description=venue-arb dashboard publisher (live.json every 60 s, history Parquet hourly, rsync to the server)

[Service]
WorkingDirectory=%h/projects/venue-arb
Environment=BWS_PROJECT_ID=42f2b924-cf96-49c8-85a3-b4e4001765b4
# same values as mise.toml [env]: systemd loads no mise, and without PGUSER/CLICKHOUSE_USER qa.db
# falls back to the superusers (tests/test_deploy.py keeps these in sync).
# VENUE_ARB_PUBLISH_DEST is shared env used by the publisher only; SERVER_IP is a placeholder, set the real one on the box
Environment=PGHOST=127.0.0.1
Environment=PGPORT=5432
Environment=PGDATABASE=app
Environment=PGUSER=venue_arb
Environment=CLICKHOUSE_HOST=127.0.0.1
Environment=CLICKHOUSE_USER=venue_arb
Environment=PREFECT_API_URL=http://127.0.0.1:4200/api
Environment=MLFLOW_TRACKING_URI=http://localhost:5050
Environment=VENUE_ARB_PUBLISH_DEST=venue-arb@SERVER_IP:/srv/venue-arb/bundle/
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/platform
ExecStart=%h/.local/bin/mise exec -- %h/.local/bin/secrets uv run python -m venue_arb.publish
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
